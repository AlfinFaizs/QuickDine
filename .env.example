# 1. Supabase API Configuration (Dari Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://dghfusubadvbuccojmoc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. PostgreSQL Connection String for Prisma ORM
# (Dari Supabase -> Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:[PASSWORD_DATABASE_ANDA]@db.dghfusubadvbuccojmoc.supabase.co:5432/postgres

# 3. Telegram Bot API (Notifikasi Dapur Resto dari @BotFather)
TELEGRAM_BOT_TOKEN=7890123456:AAFlkj987654321_your_bot_token

# 4. Payment Gateway Midtrans (Sandbox Demo)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# 5. WhatsApp Gateway Fonnte (Opsional)
