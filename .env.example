# Supabase Config (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Connection String for Prisma (from Supabase Database -> Connection string)
# Note: For Prisma ORM 7+ on Supabase, use direct or pooler connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# Payment Gateway Midtrans (Sandbox / Production)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# Telegram Bot API (Notifikasi Resmi Dapur Resto via @BotFather - 100% Gratis)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# WhatsApp Gateway Fonnte (Opsional / Backup)
FONNTE_TOKEN=your-fonnte-token

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
