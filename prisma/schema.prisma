// prisma/schema.prisma
// Skema Prisma ORM untuk QuickDine SaaS (PostgreSQL Supabase)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Restaurant {
  id                  String   @id @default(uuid())
  name                String   @db.VarChar(255)
  slug                String   @unique @db.VarChar(100)
  phoneWhatsapp       String   @map("phone_whatsapp") @db.VarChar(20)
  ownerPhone          String   @map("owner_phone") @db.VarChar(20)
  telegramChatId      String?  @map("telegram_chat_id") @db.VarChar(100)
  waGroupId           String?  @map("wa_group_id") @db.VarChar(100)
  bankName            String?  @map("bank_name") @db.VarChar(50)
  bankAccountNumber   String?  @map("bank_account_number") @db.VarChar(50)
  bankAccountHolder   String?  @map("bank_account_holder") @db.VarChar(100)
  cookTriggerMinutes  Int      @default(15) @map("cook_trigger_minutes")
  subscriptionStatus  String   @default("active") @map("subscription_status") @db.VarChar(20)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  subscriptions       Subscription[]
  tables              RestaurantTable[]
  menuItems           MenuItem[]
  orders              Order[]
  balanceLedgers      BalanceLedger[]

  @@map("restaurants")
}

model Subscription {
  id               String     @id @default(uuid())
  restaurantId     String     @map("restaurant_id")
  plan             String     @default("flat_monthly") @db.VarChar(50)
  amount           Decimal    @default(200000) @db.Decimal(12, 2)
  status           String     @default("active") @db.VarChar(20)
  periodStart      DateTime   @map("period_start") @db.Date
  periodEnd        DateTime   @map("period_end") @db.Date
  paymentReference String?    @map("payment_reference") @db.VarChar(100)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz

  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model RestaurantTable {
  id           String     @id @default(uuid())
  restaurantId String     @map("restaurant_id")
  tableNumber  String     @map("table_number") @db.VarChar(20)
  capacity     Int        @default(2)
  status       String     @default("vacant") @db.VarChar(20) // vacant, locked, reserved, occupied
  lockedUntil  DateTime?  @map("locked_until") @db.Timestamptz
  qrCodeUrl    String?    @map("qr_code_url")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([restaurantId, tableNumber], name: "unique_resto_table")
  @@map("restaurant_tables")
}

model MenuItem {
  id           String     @id @default(uuid())
  restaurantId String     @map("restaurant_id")
  categoryName String     @map("category_name") @db.VarChar(100)
  name         String     @db.VarChar(255)
  price        Decimal    @db.Decimal(12, 2)
  imageUrl     String?    @map("image_url")
  isAvailable  Boolean    @default(true) @map("is_available")
  variants     Json       @default("[]")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@map("menu_items")
}

model Order {
  id                 String           @id @default(uuid())
  restaurantId       String           @map("restaurant_id")
  tableId            String?          @map("table_id")
  customerUserId     String?          @map("customer_user_id")
  customerName       String           @map("customer_name") @db.VarChar(100)
  customerPhone      String           @map("customer_phone") @db.VarChar(20)
  arrivalTime        DateTime         @map("arrival_time") @db.Timestamptz
  gracePeriodUntil   DateTime         @map("grace_period_until") @db.Timestamptz
  subtotalAmount     Decimal          @map("subtotal_amount") @db.Decimal(12, 2)
  platformFee        Decimal          @map("platform_fee") @db.Decimal(12, 2)
  totalAmount        Decimal          @map("total_amount") @db.Decimal(12, 2)
  paymentMethod      String?          @map("payment_method") @db.VarChar(30)
  paymentStatus      String           @default("pending") @map("payment_status") @db.VarChar(20)
  orderStatus        String           @default("pending") @map("order_status") @db.VarChar(30)
  paymentReferenceId String?          @unique @map("payment_reference_id") @db.VarChar(100)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz

  restaurant         Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table              RestaurantTable? @relation(fields: [tableId], references: [id])
  items              OrderItem[]
  balanceLedgers     BalanceLedger[]

  @@map("orders")
}

model OrderItem {
  id               String    @id @default(uuid())
  orderId          String    @map("order_id")
  menuItemId       String?   @map("menu_item_id")
  itemName         String    @map("item_name") @db.VarChar(255)
  itemPrice        Decimal   @map("item_price") @db.Decimal(12, 2)
  quantity         Int
  selectedVariants Json      @default("[]") @map("selected_variants")
  specialNotes     String?   @map("special_notes")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem         MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model BalanceLedger {
  id           String     @id @default(uuid())
  restaurantId String     @map("restaurant_id")
  orderId      String?    @map("order_id")
  amount       Decimal    @db.Decimal(12, 2)
  type         String     @default("credit") @db.VarChar(20) // credit (omset masuk), debit (payout)
  description  String?    // Keterangan transaksi untuk keperluan laporan keuangan
  status       String     @default("settled") @db.VarChar(20)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order        Order?     @relation(fields: [orderId], references: [id])

  @@map("balance_ledgers")
}
